# Copy to backend/.env (recommended) or the project root .env, then add your
# own credentials. Never commit either .env file.

# Application
APP_NAME=Supplier 360
APP_VERSION=1.0.0
DEBUG=false

# Database
# Local SQLite works without credentials. For PostgreSQL, replace this with
# postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite+aiosqlite:///./supplier360.db
# Optional synchronous URL for Alembic; blank derives it from DATABASE_URL.
DATABASE_URL_SYNC=

# Qdrant (optional; blank settings use the configured local fallback)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=contract_chunks

# LLM and market pricing providers (keys are intentionally blank)
GROQ_API_KEY=
METALCHARTS_API_KEY=
LLM_MODEL_NAME=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1

# Optional Langfuse tracing. Replace these placeholders with your project
# credentials and host; tracing stays disabled until both keys are configured.
LANGFUSE_SECRET_KEY=sk-lf-8018072a-d665-43e9-8511-d8274e41b9c5
LANGFUSE_PUBLIC_KEY=pk-lf-6d405432-5516-4ef4-8c88-a3a0e5f59cfd
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false



# Keep false unless you have approved sending prompt/answer content to Langfuse.
LANGFUSE_CAPTURE_CONTENT=false

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranker (currently not wired into the retrieval pipeline)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=false

# File storage and upload limit
UPLOAD_DIR=data/contracts
MAX_UPLOAD_SIZE_MB=20

# Frontend development origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
